{
  "name": "r2-scoped-access",
  "version": "1.0.0",
  "description": "A deploy-your-own broker for short-lived, prefix-scoped Cloudflare R2 credentials.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --config wrangler.dev.jsonc --port 8787",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "policy:import-members": "node --experimental-strip-types scripts/import-members.ts",
    "db:migrate": "wrangler d1 migrations apply r2-scoped-access-audit --remote",
    "db:migrate:local": "wrangler d1 migrations apply r2-scoped-access-audit --local"
  },
  "keywords": ["cloudflare", "r2", "workers", "temporary-credentials"],
  "license": "Apache-2.0",
  "engines": { "node": ">=22.6" },
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.7",
    "jose": "^6.2.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.7",
    "@types/node": "^26.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  },
  "private": false
}
